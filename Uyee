export const MODEL_VERSION = 'radar-4';

export interface SnapshotProtocol {
  slug: string;
  name: string;
  category: string | null;
  chains: string[];
  tvl_usd: number;
  change_7d: number | null;
  mcap_usd: number | null;
  listed_at: string | null;
  gecko_id: string | null;
  symbol: string | null;
}

export interface Snapshot {
  as_of: string;
  source: string;
  floor_usd: number;
  protocols: SnapshotProtocol[];
  watchlist: string[];
}

export interface ModelConstants {
  intercept: number;
  slope: number;
  r_squared: number;
  residual_sd: number;
  comps_count: number;
  growth_slope: number;
  age_slope: number;
  category_factors: Record<string, number>;
  model_version: string;
  band_factors: number[];
  band_cutoffs: [number, number];
}

export interface BacktestResult {
  loo_miss: number;
  loo_within3: number;
  loo_within10: number;
  loo_n: number;
  time_miss: number;
  time_within3: number;
  time_n: number;
  flat_loo_miss: number;
  flat_loo_within3: number;
  flat_time_miss: number;
  flat_time_within3: number;
}

export interface CandidateResult {
  kind: string;
  loo_miss: number;
  loo_within3: number;
  time_miss: number;
  time_within3: number;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value);
}

function isFiniteNumber(value: unknown): value is number {
  return typeof value === 'number' && Number.isFinite(value);
}

function isStringOrNull(value: unknown): value is string | null {
  return value === null || typeof value === 'string';
}

export function parseSnapshot(text: string): Snapshot {
  let parsed: unknown;
  try {
    parsed = JSON.parse(text);
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    throw new Error('Invalid JSON: ' + message);
  }

  if (!isRecord(parsed)) {
    throw new Error('Snapshot must be an object');
  }
  if (typeof parsed.as_of !== 'string' || !Number.isFinite(Date.parse(parsed.as_of))) {
    throw new Error('Snapshot as_of must be a parseable date string');
  }
  if (typeof parsed.source !== 'string') {
    throw new Error('Snapshot source must be a string');
  }
  if (!Number.isInteger(parsed.floor_usd) || (parsed.floor_usd as number) <= 0) {
    throw new Error('Snapshot floor_usd must be a positive integer');
  }
  if (!Array.isArray(parsed.protocols)) {
    throw new Error('Snapshot protocols must be an array');
  }
  if (!Array.isArray(parsed.watchlist) || !parsed.watchlist.every((slug) => typeof slug === 'string')) {
    throw new Error('Snapshot watchlist must be an array of strings');
  }

  const protocols: SnapshotProtocol[] = parsed.protocols.map((protocol, index) => {
    if (!isRecord(protocol)
      || typeof protocol.slug !== 'string'
      || typeof protocol.name !== 'string'
      || !(typeof protocol.category === 'string' || protocol.category === null)
      || !Array.isArray(protocol.chains)
      || !protocol.chains.every((chain) => typeof chain === 'string')
      || !isFiniteNumber(protocol.tvl_usd)
      || !(protocol.change_7d === null || isFiniteNumber(protocol.change_7d))
      || !(protocol.mcap_usd === null || isFiniteNumber(protocol.mcap_usd))
      || !isStringOrNull(protocol.listed_at)
      || !isStringOrNull(protocol.gecko_id)
      || !isStringOrNull(protocol.symbol)) {
      throw new Error(`Invalid protocol at index ${index}`);
    }

    return {
      slug: protocol.slug,
      name: protocol.name,
      category: protocol.category,
      chains: protocol.chains.slice(),
      tvl_usd: protocol.tvl_usd,
      change_7d: protocol.change_7d,
      mcap_usd: protocol.mcap_usd,
      listed_at: protocol.listed_at,
      gecko_id: protocol.gecko_id,
      symbol: protocol.symbol,
    };
  });

  return {
    as_of: parsed.as_of,
    source: parsed.source,
    floor_usd: parsed.floor_usd as number,
    protocols,
    watchlist: parsed.watchlist.slice() as string[],
  };
}

export function ageDays(asOf: string, listedAt: string | null): number | null {
  if (listedAt === null) return null;
  const asOfMs = Date.parse(asOf);
  const listedAtMs = Date.parse(listedAt);
  if (!Number.isFinite(asOfMs) || !Number.isFinite(listedAtMs)) return null;
  return Math.max(0, Math.floor((asOfMs - listedAtMs) / 86400000));
}

export function median(values: number[]): number {
  if (values.length === 0) return 0;
  const sorted = values.slice().sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);
  if (sorted.length % 2 === 1) return sorted[middle];
  return (sorted[middle - 1] + sorted[middle]) / 2;
}

export function clamp(v: number, lo: number, hi: number): number {
  return Math.min(hi, Math.max(lo, v));
}

function regress(points: { x: number; y: number }[]): number {
  if (points.length < 2) return 0;
  const meanX = points.reduce((sum, point) => sum + point.x, 0) / points.length;
  const meanY = points.reduce((sum, point) => sum + point.y, 0) / points.length;
  let covariance = 0;
  let varianceX = 0;
  for (const point of points) {
    const dx = point.x - meanX;
    covariance += dx * (point.y - meanY);
    varianceX += dx * dx;
  }
  return varianceX === 0 ? 0 : covariance / varianceX;
}

const EXCLUDED_ASSETS = new Set(['usdt', 'usdc', 'dai', 'usde', 'usdd', 'frax']);

function isComp(p: SnapshotProtocol): boolean {
  const category = (p.category ?? '').toLowerCase();
  return Number.isFinite(p.mcap_usd)
    && (p.mcap_usd as number) > 0
    && Number.isFinite(p.tvl_usd)
    && p.tvl_usd > 0
    && category !== 'cex'
    && !category.includes('stablecoin')
    && !EXCLUDED_ASSETS.has((p.symbol ?? '').toLowerCase())
    && !EXCLUDED_ASSETS.has((p.name ?? '').toLowerCase());
}

interface LineFit {
  intercept: number;
  slope: number;
  residuals: number[];
  r_squared: number;
  residual_sd: number;
}

function fitLine(points: { x: number; y: number }[]): LineFit {
  const n = points.length;
  const xbar = points.reduce((sum, point) => sum + point.x, 0) / n;
  const ybar = points.reduce((sum, point) => sum + point.y, 0) / n;
  let xx = 0;
  let xy = 0;
  for (const point of points) {
    const dx = point.x - xbar;
    xx += dx * dx;
    xy += dx * (point.y - ybar);
  }
  const slope = xx === 0 ? 0 : xy / xx;
  const intercept = ybar - slope * xbar;
  const residuals = points.map((point) => point.y - intercept - slope * point.x);
  const sse = residuals.reduce((sum, residual) => sum + residual * residual, 0);
  const sst = points.reduce((sum, point) => sum + (point.y - ybar) ** 2, 0);
  const r_squared = sst === 0 ? (sse === 0 ? 1 : 0) : clamp(1 - sse / sst, 0, 1);
  return {
    intercept,
    slope,
    residuals,
    r_squared,
    residual_sd: Math.sqrt(sse / Math.max(1, n - 2)),
  };
}

export function fitFromComps(
  comps: SnapshotProtocol[],
  asOf: string,
  allCategories: string[],
): ModelConstants {
  if (comps.length < 3) throw new Error('At least 3 comps are required');
  const initial = fitLine(comps.map((p) => ({ x: Math.log(p.tvl_usd), y: Math.log(p.mcap_usd as number) })));
  const survivors = comps.filter((_, index) => Math.abs(initial.residuals[index]) <= 3 * initial.residual_sd);
  if (survivors.length < 3) throw new Error('At least 3 comps must remain after outlier removal');

  const points = survivors.map((p) => ({ x: Math.log(p.tvl_usd), y: Math.log(p.mcap_usd as number) }));
  const fit = fitLine(points);
  const categoryResiduals = new Map<string, number[]>();
  const growthPoints: { x: number; y: number }[] = [];
  const agePoints: { x: number; y: number }[] = [];
  survivors.forEach((p, index) => {
    const residual = fit.residuals[index];
    if (p.category !== null) {
      const values = categoryResiduals.get(p.category) ?? [];
      values.push(residual);
      categoryResiduals.set(p.category, values);
    }
    growthPoints.push({ x: clamp(p.change_7d ?? 0, -30, 60), y: residual });
    const age = ageDays(asOf, p.listed_at);
    if (age !== null) agePoints.push({ x: age / 365.25, y: residual });
  });

  const category_factors: Record<string, number> = Object.fromEntries(allCategories.map((category) => [category, 0]));
  for (const [category, residuals] of categoryResiduals) {
    if (residuals.length >= 5) {
      category_factors[category] = clamp(median(residuals) * residuals.length / (residuals.length + 5), -0.7, 0.7);
    }
  }

  const sorted = survivors.slice().sort((a, b) => a.tvl_usd - b.tvl_usd || a.slug.localeCompare(b.slug));
  const firstCut = Math.floor(sorted.length / 3);
  const secondCut = Math.floor(2 * sorted.length / 3);
  const bands = [sorted.slice(0, firstCut), sorted.slice(firstCut, secondCut), sorted.slice(secondCut)];
  const band_factors = bands.map((band) => {
    const sdBand = band.length < 10
      ? fit.residual_sd
      : 1.4826 * median(band.map((p) => Math.abs(fit.residuals[survivors.indexOf(p)])));
    return Math.exp(1.28 * sdBand);
  });

  return {
    intercept: fit.intercept,
    slope: fit.slope,
    r_squared: fit.r_squared,
    residual_sd: fit.residual_sd,
    comps_count: survivors.length,
    growth_slope: growthPoints.length < 3 ? 0 : regress(growthPoints),
    age_slope: agePoints.length < 3 ? 0 : regress(agePoints),
    category_factors,
    model_version: MODEL_VERSION,
    band_factors,
    band_cutoffs: [sorted[firstCut].tvl_usd, sorted[secondCut].tvl_usd],
  };
}

export function fitModel(snapshot: Snapshot): ModelConstants {
  const allCategories = [...new Set(snapshot.protocols
    .map((p) => p.category)
    .filter((category): category is string => category !== null))].sort();
  return fitFromComps(snapshot.protocols.filter(isComp), snapshot.as_of, allCategories);
}

export function impliedValue(
  p: SnapshotProtocol,
  model: ModelConstants,
  asOf: string,
  siblingFactor?: number,
): number {
  const base = Math.exp(model.intercept + model.slope * Math.log(Math.max(p.tvl_usd, 1)));
  const cat = Math.exp(model.category_factors[p.category ?? ''] ?? 0);
  const growth = Math.exp(model.growth_slope * clamp(p.change_7d ?? 0, -30, 60));
  const age = Math.exp(model.age_slope * (ageDays(asOf, p.listed_at) ?? 0) / 365.25);
  return base * cat * growth * age * (siblingFactor ?? 1);
}

export function bandFor(tvlUsd: number, model: ModelConstants): number {
  const index = tvlUsd < model.band_cutoffs[0] ? 0 : tvlUsd < model.band_cutoffs[1] ? 1 : 2;
  return model.band_factors[index];
}

export function valueBand(
  value: number,
  tvlUsd: number,
  model: ModelConstants,
): { low: number; high: number } {
  const band = bandFor(tvlUsd, model);
  return { low: value / band, high: value * band };
}

export function familyOf(name: string): string {
  return name.toLowerCase().replace(/\s+(v\d+(\.\d+)?|\d+\.\d+)$/i, '').trim();
}

export function siblingFactors(snapshot: Snapshot): Record<string, number> {
  const families = new Map<string, SnapshotProtocol[]>();
  for (const protocol of snapshot.protocols) {
    const family = familyOf(protocol.name);
    const members = families.get(family) ?? [];
    members.push(protocol);
    families.set(family, members);
  }
  return Object.fromEntries(snapshot.protocols.map((protocol) => {
    const size = families.get(familyOf(protocol.name))?.length ?? 1;
    return [protocol.slug, 1 / (1 + 0.5 * (size - 1))];
  }));
}

function miss(errors: number[]): number {
  return errors.length === 0 ? 0 : Math.exp(median(errors));
}

function within(errors: number[], factor: number): number {
  return errors.length === 0 ? 0 : errors.filter((error) => error <= Math.log(factor)).length / errors.length;
}

function medianMultiple(comps: SnapshotProtocol[]): number {
  return median(comps.map((p) => (p.mcap_usd as number) / p.tvl_usd));
}

function sortedCategories(comps: SnapshotProtocol[]): string[] {
  return [...new Set(comps.map((p) => p.category).filter((category): category is string => category !== null))].sort();
}

export function backtestModel(snapshot: Snapshot): BacktestResult {
  const comps = snapshot.protocols.filter(isComp);
  const allCategories = sortedCategories(snapshot.protocols);
  const looErrors: number[] = [];
  const flatLooErrors: number[] = [];
  for (let index = 0; index < comps.length; index += 1) {
    const comp = comps[index];
    const train = comps.filter((_, candidateIndex) => candidateIndex !== index);
    const foldModel = fitFromComps(train, snapshot.as_of, allCategories);
    const predicted = Math.log(impliedValue(comp, foldModel, snapshot.as_of));
    looErrors.push(Math.abs(Math.log(comp.mcap_usd as number) - predicted));
    const flatPrediction = Math.log(medianMultiple(train)) + Math.log(comp.tvl_usd);
    flatLooErrors.push(Math.abs(Math.log(comp.mcap_usd as number) - flatPrediction));
  }

  const cutoff = Date.parse('2025-01-01');
  const datedComps = comps.filter((p) => p.listed_at !== null && Number.isFinite(Date.parse(p.listed_at)));
  const timeTrain = datedComps.filter((p) => Date.parse(p.listed_at as string) < cutoff);
  const timeTest = datedComps.filter((p) => Date.parse(p.listed_at as string) >= cutoff);
  const timeErrors: number[] = [];
  const flatTimeErrors: number[] = [];
  if (timeTest.length > 0) {
    const timeModel = fitFromComps(timeTrain, snapshot.as_of, allCategories);
    const trainMultiple = Math.log(medianMultiple(timeTrain));
    for (const comp of timeTest) {
      const predicted = Math.log(impliedValue(comp, timeModel, snapshot.as_of));
      timeErrors.push(Math.abs(Math.log(comp.mcap_usd as number) - predicted));
      const flatPrediction = trainMultiple + Math.log(comp.tvl_usd);
      flatTimeErrors.push(Math.abs(Math.log(comp.mcap_usd as number) - flatPrediction));
    }
  }

  return {
    loo_miss: miss(looErrors),
    loo_within3: within(looErrors, 3),
    loo_within10: within(looErrors, 10),
    loo_n: comps.length,
    time_miss: miss(timeErrors),
    time_within3: within(timeErrors, 3),
    time_n: timeTest.length,
    flat_loo_miss: miss(flatLooErrors),
    flat_loo_within3: within(flatLooErrors, 3),
    flat_time_miss: miss(flatTimeErrors),
    flat_time_within3: within(flatTimeErrors, 3),
  };
}

function solveLinearSystem(matrix: number[][], vector: number[]): number[] {
  const n = vector.length;
  const rows = matrix.map((row, index) => [...row, vector[index]]);
  for (let column = 0; column < n; column += 1) {
    let pivot = column;
    for (let row = column + 1; row < n; row += 1) {
      if (Math.abs(rows[row][column]) > Math.abs(rows[pivot][column])) pivot = row;
    }
    if (Math.abs(rows[pivot][column]) < 1e-12) continue;
    [rows[column], rows[pivot]] = [rows[pivot], rows[column]];
    const divisor = rows[column][column];
    for (let j = column; j <= n; j += 1) rows[column][j] /= divisor;
    for (let row = 0; row < n; row += 1) {
      if (row === column) continue;
      const factor = rows[row][column];
      for (let j = column; j <= n; j += 1) rows[row][j] -= factor * rows[column][j];
    }
  }
  return rows.map((row, index) => Math.abs(row[index]) < 1e-12 ? 0 : row[n]);
}

function weightedLine(points: { x: number; y: number; weight: number }[]): { intercept: number; slope: number } {
  const weightSum = points.reduce((sum, point) => sum + point.weight, 0);
  const xbar = points.reduce((sum, point) => sum + point.weight * point.x, 0) / weightSum;
  const ybar = points.reduce((sum, point) => sum + point.weight * point.y, 0) / weightSum;
  let xx = 0;
  let xy = 0;
  for (const point of points) {
    const dx = point.x - xbar;
    xx += point.weight * dx * dx;
    xy += point.weight * dx * (point.y - ybar);
  }
  const slope = xx === 0 ? 0 : xy / xx;
  return { slope, intercept: ybar - slope * xbar };
}

function fitPredictor(
  kind: string,
  train: SnapshotProtocol[],
  asOf: string,
  allCategories: string[],
): (p: SnapshotProtocol) => number {
  if (kind === 'ols') {
    const model = fitFromComps(train, asOf, allCategories);
    return (p) => Math.log(impliedValue(p, model, asOf));
  }

  const trainPoints = train.map((p) => ({ x: Math.log(p.tvl_usd), y: Math.log(p.mcap_usd as number) }));
  if (kind.startsWith('ridge-')) {
    const lambda = Number(kind.slice('ridge-'.length));
    const mean = trainPoints.reduce((sum, point) => sum + point.x, 0) / trainPoints.length;
    const sd = Math.sqrt(trainPoints.reduce((sum, point) => sum + (point.x - mean) ** 2, 0) / trainPoints.length) || 1;
    const categories = sortedCategories(train);
    const dimensions = 2 + categories.length;
    const normal = Array.from({ length: dimensions }, () => Array(dimensions).fill(0) as number[]);
    const target = Array(dimensions).fill(0) as number[];
    for (const p of train) {
      const features = [1, (Math.log(p.tvl_usd) - mean) / sd, ...categories.map((category) => p.category === category ? 1 : 0)];
      const y = Math.log(p.mcap_usd as number);
      for (let i = 0; i < dimensions; i += 1) {
        target[i] += features[i] * y;
        for (let j = 0; j < dimensions; j += 1) normal[i][j] += features[i] * features[j];
      }
    }
    for (let i = 1; i < dimensions; i += 1) normal[i][i] += lambda;
    const beta = solveLinearSystem(normal, target);
    return (p) => {
      const categoryIndex = p.category === null ? -1 : categories.indexOf(p.category);
      return beta[0] + beta[1] * ((Math.log(p.tvl_usd) - mean) / sd) + (categoryIndex < 0 ? 0 : beta[2 + categoryIndex]);
    };
  }

  if (kind === 'piecewise') {
    const sorted = train.slice().sort((a, b) => a.tvl_usd - b.tvl_usd || a.slug.localeCompare(b.slug));
    const firstCut = sorted[Math.floor(sorted.length / 3)].tvl_usd;
    const secondCut = sorted[Math.floor(2 * sorted.length / 3)].tvl_usd;
    const buckets = [
      sorted.filter((p) => p.tvl_usd < firstCut),
      sorted.filter((p) => p.tvl_usd >= firstCut && p.tvl_usd < secondCut),
      sorted.filter((p) => p.tvl_usd >= secondCut),
    ];
    const global = fitLine(trainPoints);
    const lines = buckets.map((bucket) => {
      if (bucket.length < 3) return global;
      const fit = fitLine(bucket.map((p) => ({ x: Math.log(p.tvl_usd), y: Math.log(p.mcap_usd as number) })));
      return { intercept: fit.intercept, slope: fit.slope };
    });
    return (p) => {
      const index = p.tvl_usd < firstCut ? 0 : p.tvl_usd < secondCut ? 1 : 2;
      return lines[index].intercept + lines[index].slope * Math.log(p.tvl_usd);
    };
  }

  if (kind === 'category-median') {
    const globalMultiple = medianMultiple(train);
    const multiples = new Map<string, number[]>();
    for (const p of train) {
      if (p.category === null) continue;
      const values = multiples.get(p.category) ?? [];
      values.push((p.mcap_usd as number) / p.tvl_usd);
      multiples.set(p.category, values);
    }
    const categoryMultiples = new Map([...multiples].map(([category, values]) => [category, median(values)]));
    return (p) => Math.log(categoryMultiples.get(p.category ?? '') ?? globalMultiple) + Math.log(p.tvl_usd);
  }

  if (kind.startsWith('knn-')) {
    const k = Number(kind.slice('knn-'.length));
    return (p) => {
      const nearest = train.slice().sort((a, b) => {
        const da = Math.abs(Math.log(p.tvl_usd) - Math.log(a.tvl_usd));
        const db = Math.abs(Math.log(p.tvl_usd) - Math.log(b.tvl_usd));
        return da - db || a.slug.localeCompare(b.slug);
      }).slice(0, Math.min(k, train.length));
      return nearest.reduce((sum, comp) => sum + Math.log(comp.mcap_usd as number), 0) / nearest.length;
    };
  }

  if (kind === 'lad') {
    let line = fitLine(trainPoints);
    for (let iteration = 0; iteration < 10; iteration += 1) {
      const weighted = trainPoints.map((point) => ({
        ...point,
        weight: 1 / Math.max(Math.abs(point.y - line.intercept - line.slope * point.x), 0.1),
      }));
      line = weightedLine(weighted);
    }
    const residuals = trainPoints.map((point) => point.y - line.intercept - line.slope * point.x);
    const categoryResiduals = new Map<string, number[]>();
    const growthPoints: { x: number; y: number }[] = [];
    const agePoints: { x: number; y: number }[] = [];
    train.forEach((p, index) => {
      if (p.category !== null) {
        const values = categoryResiduals.get(p.category) ?? [];
        values.push(residuals[index]);
        categoryResiduals.set(p.category, values);
      }
      growthPoints.push({ x: clamp(p.change_7d ?? 0, -30, 60), y: residuals[index] });
      const age = ageDays(asOf, p.listed_at);
      if (age !== null) agePoints.push({ x: age / 365.25, y: residuals[index] });
    });
    const factors = new Map<string, number>();
    for (const [category, values] of categoryResiduals) {
      if (values.length >= 5) factors.set(category, clamp(median(values) * values.length / (values.length + 5), -0.7, 0.7));
    }
    const growthSlope = growthPoints.length < 3 ? 0 : regress(growthPoints);
    const ageSlope = agePoints.length < 3 ? 0 : regress(agePoints);
    return (p) => {
      const category = p.category === null ? 0 : factors.get(p.category) ?? 0;
      const growth = growthSlope * clamp(p.change_7d ?? 0, -30, 60);
      const age = ageSlope * (ageDays(asOf, p.listed_at) ?? 0) / 365.25;
      return line.intercept + line.slope * Math.log(p.tvl_usd) + category + growth + age;
    };
  }

  throw new Error(`Unknown candidate kind: ${kind}`);
}

export function evaluateCandidates(snapshot: Snapshot): CandidateResult[] {
  const kinds = ['ols', 'ridge-0.1', 'ridge-1', 'ridge-10', 'piecewise', 'category-median', 'knn-5', 'knn-10', 'lad'];
  const comps = snapshot.protocols.filter(isComp);
  const allCategories = sortedCategories(snapshot.protocols);
  const cutoff = Date.parse('2025-01-01');
  const datedComps = comps.filter((p) => p.listed_at !== null && Number.isFinite(Date.parse(p.listed_at)));
  const timeTrain = datedComps.filter((p) => Date.parse(p.listed_at as string) < cutoff);
  const timeTest = datedComps.filter((p) => Date.parse(p.listed_at as string) >= cutoff);
  return kinds.map((kind): CandidateResult => {
    const looErrors: number[] = [];
    for (let index = 0; index < comps.length; index += 1) {
      const comp = comps[index];
      const train = comps.filter((_, candidateIndex) => candidateIndex !== index);
      const predict = fitPredictor(kind, train, snapshot.as_of, allCategories);
      looErrors.push(Math.abs(Math.log(comp.mcap_usd as number) - predict(comp)));
    }
    const timeErrors: number[] = [];
    if (timeTest.length > 0) {
      const predict = fitPredictor(kind, timeTrain, snapshot.as_of, allCategories);
      for (const comp of timeTest) timeErrors.push(Math.abs(Math.log(comp.mcap_usd as number) - predict(comp)));
    }
    return {
      kind,
      loo_miss: miss(looErrors),
      loo_within3: within(looErrors, 3),
      time_miss: miss(timeErrors),
      time_within3: within(timeErrors, 3),
    };
  });
}

export function holdDaysFor(ageDaysValue: number | null): number {
  if (ageDaysValue === null) return 30;
  if (ageDaysValue < 180) return 60;
  if (ageDaysValue < 365) return 45;
  return 30;
}

const GAS_GROUPS: Array<[number, string[]]> = [
  [3.00, ['Ethereum', 'EthereumClassic', 'EthereumPoW', 'MegaETH', 'Etherlink', 'Ethereal']],
  [0.20, ['Base', 'Arbitrum', 'Arbitrum Nova', 'Optimism', 'Unichain', 'Katana', 'Morph', 'Ink', 'Plasma', 'Avalanche', 'Berachain', 'Arc', 'Tempo', 'zkSync Era', 'Linea', 'Scroll', 'Blast', 'Mode', 'Fraxtal']],
  [0.05, ['Solana', 'Sui', 'Aptos', 'Monad', 'Hyperliquid L1']],
  [0.10, ['Binance', 'Op_Bnb', 'Boba_Bnb']],
  [0.10, ['Polygon', 'Polygon zkEVM']],
];

export const GAS_PER_TX: Record<string, number> = Object.fromEntries(
  GAS_GROUPS.flatMap(([cost, chains]) => chains.map((chain) => [chain.trim().toLowerCase(), cost])),
);

export function gasPerTx(chain: string): number {
  return GAS_PER_TX[chain.trim().toLowerCase()] ?? 0.50;
}

function roundMoney(value: number): number {
  return Math.round((value + Number.EPSILON) * 100) / 100;
}

function moneyText(value: number): string {
  return '$' + value.toFixed(2);
}

export interface FarmPlan {
  hold_days: number;
  per_tx: number;
  tx_count: number;
  gas_usd: number;
  fees_usd: number;
  forgone_usd: number;
  slice_usd: number;
  net_usd: number;
  work_hours: number;
  net_per_hour_usd: number;
  verdict: 'FARM' | 'THIN' | 'SKIP';
  implied_value_usd: number;
  chain: string;
}

export function farmPlan(
  p: SnapshotProtocol,
  model: ModelConstants,
  asOf: string,
  siblingFactor?: number,
): FarmPlan {
  const chain = p.chains[0] ?? 'Unknown';
  const per_tx = gasPerTx(chain);
  const hold_days = holdDaysFor(ageDays(asOf, p.listed_at));
  const weeks = Math.ceil(hold_days / 7);
  const tx_count = 1 + 1 + weeks + 1;
  const gas_usd = roundMoney(Math.max(1.00, per_tx * tx_count));
  const fees_usd = roundMoney(2);
  const forgone_usd = roundMoney(1000 * 0.04 * (hold_days / 365));
  const implied_value_usd = Math.max(1, Math.round(impliedValue(p, model, asOf, siblingFactor)));
  const slice_usd = roundMoney(implied_value_usd * 0.10 * (1000 / p.tvl_usd));
  const net_usd = roundMoney(slice_usd - gas_usd - fees_usd - forgone_usd);
  const work_hours = 0.25 + 0.17 * (hold_days / 7) + 0.17;
  const net_per_hour_usd = roundMoney(net_usd / work_hours);
  const verdict = net_per_hour_usd >= 2
    && slice_usd >= 2 * (gas_usd + fees_usd + forgone_usd)
    ? 'FARM'
    : net_usd > 0 ? 'THIN' : 'SKIP';
  return {
    hold_days, per_tx, tx_count, gas_usd, fees_usd, forgone_usd, slice_usd, net_usd,
    work_hours, net_per_hour_usd, verdict, implied_value_usd, chain,
  };
}

function stepText(text: string, cost: string, time: string): string {
  let result = text + ' Cost: ' + cost + '. Time: ' + time + '.';
  if (result.length < 20) result += ' Follow the protocol published instructions.';
  if (result.length > 600) result = result.slice(0, 597) + '...';
  return result.trim();
}

function farmActions(category: string | null): [string, string] {
  const value = (category ?? '').toLowerCase();
  if (value.includes('lend') || value.includes('cdp') || value.includes('collateral')) {
    return ['Supply USDC as collateral and borrow a small amount against it', 'Repay a little of the borrow and top up collateral if the health factor fell'];
  }
  if (value.includes('dex') || value.includes('amm')) {
    return ['Provide USDC liquidity in the most active pool', 'Rebalance the position and collect the trading fees'];
  }
  if (value.includes('bridge')) {
    return ['Bridge USDC to the chain and back, keeping the receipts', 'Make one small bridge each way and keep the receipts'];
  }
  if (value.includes('staking') || value.includes('restak')) {
    return ['Stake the chain asset through the protocol', 'Check delegation and restake the rewards'];
  }
  if (/\b(perpetual|derivative|options|futures)\b/.test(value)) {
    return ['Deposit margin and open a small hedged position', 'Close and reopen the hedge at the new price'];
  }
  if (value.includes('prediction')) {
    return ['Fund a position in an open market', 'Adjust the position as the odds move'];
  }
  if (value.includes('curator') || value.includes('allocator')) {
    return ['Deposit into a vault', 'Check the vault allocation'];
  }
  if (value.includes('stable')) {
    return ['Mint or deposit the stable asset', 'Check the peg and the backing'];
  }
  if (value.includes('rwa')) {
    return ['Mint the yield-bearing asset', 'Check the yield accrual'];
  }
  if (value.includes('insurance')) {
    return ['Buy cover for a position you hold', 'Check the cover terms and expiry'];
  }
  if (value.includes('yield') || value.includes('leveraged farm') || value.includes('vault')) {
    return ['Deposit into the highest-yield vault', 'Harvest the yield and redeposit it'];
  }
  return [
    "Deposit USDC following the protocol's published requirements",
    "Do one qualifying action under the protocol's published requirements",
  ];
}

export function farmSteps(p: SnapshotProtocol, plan: FarmPlan, _model: ModelConstants, _asOf: string): string[] {
  const [entryAction, weeklyAction] = farmActions(p.category);
  const weeks = Math.ceil(plan.hold_days / 7);
  const topUp = roundMoney(Math.max(0, plan.gas_usd - plan.per_tx * plan.tx_count));
  const setupGas = roundMoney(plan.per_tx + topUp);
  let setupText = 'Setup — Set up a wallet on ' + plan.chain + ' and fund it with $1,000 USDC';
  if (plan.per_tx * plan.tx_count < 1.00) {
    setupText += '; includes a ' + moneyText(topUp) + ' minimum network-cost top-up';
  }
  const weeklyGas = roundMoney(weeks * plan.per_tx);
  return [
    stepText(setupText, moneyText(setupGas) + ' gas', '5 min'),
    stepText('Entry — ' + entryAction, moneyText(plan.per_tx) + ' gas', '10 min'),
    stepText('Weekly — ' + weeklyAction, moneyText(weeklyGas) + ' gas (' + weeks + ' weekly actions x ' + moneyText(plan.per_tx) + ' = ' + moneyText(weeklyGas) + ')', '10.2 min each week'),
    stepText('Hold — Hold the position for ' + plan.hold_days + ' days and watch the protocol\'s published requirements', moneyText(plan.forgone_usd) + ' forgone yield at 4% annually; ' + moneyText(plan.fees_usd) + ' total fees over ' + plan.hold_days + ' days', plan.hold_days + ' days'),
    stepText('Claim — Claim any rewards and withdraw the position', moneyText(plan.per_tx) + ' gas', '5.1 min'),
    stepText('Log — Log every transaction hash, receipt and date in one place', moneyText(0) + '', '5.1 min'),
  ];
}

export interface SensitivityCounts {
  farm: number;
  thin: number;
  skip: number;
}

export function sensitivityCounts(rows: Array<Pick<FarmPlan, 'slice_usd' | 'gas_usd' | 'fees_usd' | 'forgone_usd' | 'work_hours'>>): {
  five: SensitivityCounts;
  ten: SensitivityCounts;
  twenty: SensitivityCounts;
} {
  const countFor = (share: number): SensitivityCounts => {
    const counts: SensitivityCounts = { farm: 0, thin: 0, skip: 0 };
    for (const row of rows) {
      const slice = row.slice_usd * (share / 0.10);
      const cost = row.gas_usd + row.fees_usd + row.forgone_usd;
      const net = slice - cost;
      const perHour = net / row.work_hours;
      const verdict = perHour >= 2 && slice >= 2 * cost ? 'farm' : net > 0 ? 'thin' : 'skip';
      counts[verdict] += 1;
    }
    return counts;
  };
  return { five: countFor(0.05), ten: countFor(0.10), twenty: countFor(0.20) };
}

export const EARLY_ROWS = 160;
export const LIVE_ROWS = 24;

const EXCLUDED_NAMES = new Set(['usdt', 'usdc', 'dai', 'usde', 'usdd', 'frax']);
const EXCLUDED_STAKING_CATEGORIES = new Set(['liquid staking', 'liquid restaking', 'restaking', 'staking pool']);

function isPreToken(p: SnapshotProtocol): boolean {
  return p.mcap_usd === null && p.gecko_id === null && p.symbol === null;
}

function isRankable(p: SnapshotProtocol): boolean {
  const category = p.category?.toLowerCase() ?? '';
  const name = p.name.toLowerCase();
  return isPreToken(p)
    && p.category !== 'CEX'
    && !/\s+(?:v\d+(?:\.\d+)?|\d+\.\d+)$/i.test(p.name)
    && (p.category === null || !category.includes('stablecoin'))
    && !/^(?:wrapped|staked|bridged)/i.test(p.name)
    && !EXCLUDED_STAKING_CATEGORIES.has(category)
    && !/\b(?:staked|staking|wrapped|bridged)\b/i.test(p.name)
    && !/\b(?:lst|lsts)\b/i.test(p.name)
    && !EXCLUDED_NAMES.has((p.symbol ?? '').toLowerCase())
    && !EXCLUDED_NAMES.has(name);
}

export interface BoardRow extends SnapshotProtocol {
  rank: number;
  token_status: 'pre-token';
  age_days: number | null;
  implied_value_usd: number;
  implied_low_usd: number;
  implied_high_usd: number;
  model: {
    base_usd: number;
    category_multiplier: number;
    growth_multiplier: number;
    age_multiplier: number;
    sibling_multiplier: number;
    age_days: number | null;
  };
  verdict: FarmPlan['verdict'];
  slice_usd: number;
  net_per_hour_usd: number;
  gas_usd: number;
  fees_usd: number;
  forgone_usd: number;
  work_hours: number;
  capital_usd: number;
  flag?: 'verify';
  farm_steps: string[];
}

function compareSlug(a: string, b: string): number {
  return a < b ? -1 : a > b ? 1 : 0;
}

function boardWithModel(snapshot: Snapshot, model: ModelConstants): BoardRow[] {
  const watchlist = new Set(snapshot.watchlist);
  const siblings = siblingFactors(snapshot);
  const scored = snapshot.protocols.filter(isRankable).map((protocol) => ({
    protocol,
    value: impliedValue(protocol, model, snapshot.as_of, siblings[protocol.slug]),
  }));
  // Early rows are the 160 highest-implied-value rankable pre-token protocols BELOW the watchlist floor; protocols at or above the floor reach the board only through the watchlist.
  const selectedEarly = scored
    .filter(({ protocol }) => !watchlist.has(protocol.slug) && protocol.tvl_usd < snapshot.floor_usd)
    .sort((a, b) => b.value - a.value || compareSlug(a.protocol.slug, b.protocol.slug))
    .slice(0, EARLY_ROWS);
  const selected = [
    ...snapshot.protocols.filter((protocol) => watchlist.has(protocol.slug)),
    ...selectedEarly.map(({ protocol }) => protocol),
  ];
  const scoredValues = new Map(scored.map(({ protocol, value }) => [protocol, value]));
  selected.sort((a, b) => {
    const valueA = scoredValues.get(a) ?? impliedValue(a, model, snapshot.as_of, siblings[a.slug]);
    const valueB = scoredValues.get(b) ?? impliedValue(b, model, snapshot.as_of, siblings[b.slug]);
    return valueB - valueA || compareSlug(a.slug, b.slug);
  });

  return selected.map((protocol, index): BoardRow => {
    const age_days = ageDays(snapshot.as_of, protocol.listed_at);
    const sibling_multiplier = siblings[protocol.slug] ?? 1;
    const baseRaw = Math.exp(model.intercept + model.slope * Math.log(Math.max(protocol.tvl_usd, 1)));
    const category_multiplier = Math.exp(model.category_factors[protocol.category ?? ''] ?? 0);
    const growth_multiplier = Math.exp(model.growth_slope * clamp(protocol.change_7d ?? 0, -30, 60));
    const age_multiplier = Math.exp(model.age_slope * (age_days ?? 0) / 365.25);
    const value = impliedValue(protocol, model, snapshot.as_of, sibling_multiplier);
    const implied_value_usd = Math.max(1, Math.round(value));
    const bounds = valueBand(value, protocol.tvl_usd, model);
    const implied_low_usd = Math.max(1, Math.round(bounds.low));
    const implied_high_usd = Math.max(1, Math.round(bounds.high));
    const plan = farmPlan(protocol, model, snapshot.as_of, sibling_multiplier);
    const row: BoardRow = {
      ...protocol,
      chains: protocol.chains.slice(),
      rank: index + 1,
      token_status: 'pre-token',
      age_days,
      implied_value_usd,
      implied_low_usd,
      implied_high_usd,
      model: {
        base_usd: Math.round(baseRaw),
        category_multiplier,
        growth_multiplier,
        age_multiplier,
        sibling_multiplier,
        age_days,
      },
      verdict: plan.verdict,
      slice_usd: plan.slice_usd,
      net_per_hour_usd: plan.net_per_hour_usd,
      gas_usd: plan.gas_usd,
      fees_usd: plan.fees_usd,
      forgone_usd: plan.forgone_usd,
      work_hours: plan.work_hours,
      capital_usd: 1000,
      farm_steps: farmSteps(protocol, plan, model, snapshot.as_of),
    };
    if (watchlist.has(protocol.slug) && !isRankable(protocol)) row.flag = 'verify';
    return row;
  });
}

export function buildBoard(snapshot: Snapshot): BoardRow[] {
  return boardWithModel(snapshot, fitModel(snapshot));
}

export interface LiveRow {
  slug: string;
  name: string;
  category: string | null;
  chains: string[];
  tvl_usd: number;
  mcap_usd: number | null;
  change_7d: number | null;
}

export function liveRows(snapshot: Snapshot): LiveRow[] {
  return snapshot.protocols
    .filter((protocol) => !isPreToken(protocol) && protocol.category !== 'CEX')
    .slice()
    .sort((a, b) => {
      const mcapA = a.mcap_usd ?? -Infinity;
      const mcapB = b.mcap_usd ?? -Infinity;
      return mcapB - mcapA || b.tvl_usd - a.tvl_usd || compareSlug(a.slug, b.slug);
    })
    .slice(0, LIVE_ROWS)
    .map((protocol) => ({
      slug: protocol.slug,
      name: protocol.name,
      category: protocol.category,
      chains: protocol.chains.slice(),
      tvl_usd: protocol.tvl_usd,
      mcap_usd: protocol.mcap_usd,
      change_7d: protocol.change_7d,
    }));
}

export type RadarRow = Omit<BoardRow, 'model'>;

export interface RadarData {
  as_of: string;
  source: string;
  floor_usd: number;
  model: ModelConstants;
  backtest: BacktestResult;
  watchlist_size: number;
  board_size: number;
  early_size: number;
  live_size: number;
  farm_counts: SensitivityCounts;
  yardstick: Array<{ category: string; comps: number; median_multiple: number; factor: number }>;
  rows: RadarRow[];
  live: LiveRow[];
}

function compSurvivors(snapshot: Snapshot): SnapshotProtocol[] {
  const comps = snapshot.protocols.filter(isComp);
  if (comps.length < 3) throw new Error('At least 3 comps are required');
  const initial = fitLine(comps.map((p) => ({ x: Math.log(p.tvl_usd), y: Math.log(p.mcap_usd as number) })));
  const survivors = comps.filter((_, index) => Math.abs(initial.residuals[index]) <= 3 * initial.residual_sd);
  if (survivors.length < 3) throw new Error('At least 3 comps must remain after outlier removal');
  return survivors;
}

export function buildRadar(snapshot: Snapshot): { board: BoardRow[]; radar: RadarData } {
  const model = fitModel(snapshot);
  const board = boardWithModel(snapshot, model);
  const live = liveRows(snapshot);
  const watchlist = new Set(snapshot.watchlist);
  const boardCounts: SensitivityCounts = { farm: 0, thin: 0, skip: 0 };
  for (const row of board) {
    if (row.verdict === 'FARM') boardCounts.farm += 1;
    else if (row.verdict === 'THIN') boardCounts.thin += 1;
    else boardCounts.skip += 1;
  }
  const categoryGroups = new Map<string, SnapshotProtocol[]>();
  for (const comp of compSurvivors(snapshot)) {
    if (comp.category === null) continue;
    const values = categoryGroups.get(comp.category) ?? [];
    values.push(comp);
    categoryGroups.set(comp.category, values);
  }
  const yardstick = [...categoryGroups.entries()].sort(([a], [b]) => compareSlug(a, b)).map(([category, comps]) => ({
    category,
    comps: comps.length,
    median_multiple: median(comps.map((comp) => (comp.mcap_usd as number) / comp.tvl_usd)),
    factor: model.category_factors[category] ?? 0,
  }));
  const rows: RadarRow[] = board.map((row) => {
    const { model: _decomposition, ...radarRow } = row;
    return radarRow;
  });
  const radar: RadarData = {
    as_of: snapshot.as_of,
    source: snapshot.source,
    floor_usd: snapshot.floor_usd,
    model,
    backtest: backtestModel(snapshot),
    watchlist_size: snapshot.watchlist.length,
    board_size: board.length,
    early_size: board.filter((row) => !watchlist.has(row.slug)).length,
    live_size: live.length,
    farm_counts: boardCounts,
    yardstick,
    rows,
    live,
  };
  return { board, radar };
}

export function boardIssue(board: BoardRow[], snapshot: Snapshot): string | null {
  const boardSlugs = new Set(board.map((row) => row.slug));
  for (const slug of snapshot.watchlist) {
    if (!boardSlugs.has(slug)) return 'Watchlist slug missing from board: ' + slug;
  }
  for (let index = 0; index < board.length; index += 1) {
    if (board[index].rank !== index + 1) return 'Board ranks are not exactly 1..N';
  }
  for (let index = 1; index < board.length; index += 1) {
    if (board[index].implied_value_usd > board[index - 1].implied_value_usd) {
      return 'Implied value rises with rank';
    }
  }
  if (board.length > 0 && board[0].implied_value_usd === board[board.length - 1].implied_value_usd) {
    return 'All board implied values are equal';
  }
  for (const row of board) {
    if (!Array.isArray(row.farm_steps) || row.farm_steps.length < 3 || row.farm_steps.length > 12) {
      return 'Farm steps must contain 3–12 entries for ' + row.slug;
    }
    for (const step of row.farm_steps) {
      if (typeof step !== 'string' || step.trim() !== step || step.length < 20 || step.length > 600) {
        return 'Invalid farm step for ' + row.slug;
      }
    }
    if (!Number.isSafeInteger(row.implied_value_usd) || row.implied_value_usd <= 0) {
      return 'Invalid implied value for ' + row.slug;
    }
  }
  return null;
}

export function dataScript(radar: RadarData): string {
  return 'window.RADAR=' + JSON.stringify(radar) + ';\n';
}
